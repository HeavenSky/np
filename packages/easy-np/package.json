{
  "name": "easy-np",
  "version": "0.0.2",
  "description": "Fast npm installer forked from npminstall, with npm@6 style --dedup hoisting, npm workspaces fixes and node 16 support",
  "keywords": [
    "dedup",
    "hoist",
    "installer",
    "monorepo",
    "npm",
    "npm install",
    "npminstall",
    "workspaces"
  ],
  "homepage": "https://github.com/HeavenSky/np/tree/main/packages/easy-np#readme",
  "bugs": {
    "url": "https://github.com/HeavenSky/np/issues"
  },
  "license": "MIT",
  "author": "HeavenSky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeavenSky/np.git",
    "directory": "packages/easy-np"
  },
  "bin": {
    "np": "bin/i.js",
    "np-x": "bin/x.js"
  },
  "files": [
    "lib",
    "bin",
    "node-gyp-bin",
    "CHANGELOG.md"
  ],
  "main": "lib/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "npm run lint && mocha \"test/*.test.js\"",
    "test-cov": "c8 --reporter=text --reporter=lcov mocha \"test/*.test.js\"",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "ci": "npm run lint && npm run test-cov",
    "prepublishOnly": "npm run lint"
  },
  "dependencies": {
    "@npmcli/arborist": "^6.5.1",
    "@zkochan/cmd-shim": "^5.4.0",
    "await-event": "^2.1.0",
    "bin-links": "^2.3.0",
    "binary-mirror-config": "^1.19.0",
    "bug-versions": "^1.90.0",
    "bytes": "^3.1.0",
    "cacheable-lookup": "^6.1.0",
    "chalk": "^2.4.2",
    "dayjs": "^1.11.23",
    "destroy": "^1.0.4",
    "detect-libc": "^2.0.1",
    "execa": "^5.1.1",
    "fs-extra": "^7.0.1",
    "globby": "^11.1.0",
    "minimatch": "^3.0.4",
    "minimist": "^1.2.0",
    "ms": "^2.1.1",
    "node-gyp": "^10.3.1",
    "node-homedir": "^1.1.1",
    "normalize-package-data": "^5.0.0",
    "npm-normalize-package-bin": "^3.0.0",
    "npm-package-arg": "^8.1.5",
    "ora": "^4.0.5",
    "p-map": "^2.1.0",
    "pacote": "^15.2.0",
    "rc": "^1.2.8",
    "semver": "^7.0.0",
    "tar": "^7.5.22",
    "urllib": "^3.27.3"
  },
  "devDependencies": {
    "assert-file": "^1.0.0",
    "c8": "^9.1.0",
    "coffee": "^5.5.0",
    "mm": "^3.2.1",
    "mocha": "^11.7.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0"
  },
  "engines": {
    "node": ">=16.14.0"
  }
}
