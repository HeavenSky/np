{
  "name": "easy-npd",
  "version": "0.0.1",
  "description": "Fast npm installer forked from npminstall 6.8.0, with flat _name@version@name layout, latest-version hoisting and node 16 support",
  "keywords": [
    "dedup",
    "hoist",
    "installer",
    "npm",
    "npm install",
    "npminstall"
  ],
  "homepage": "https://github.com/HeavenSky/np/tree/main/packages/easy-npd#readme",
  "bugs": {
    "url": "https://github.com/HeavenSky/np/issues"
  },
  "license": "MIT",
  "author": "HeavenSky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeavenSky/np.git",
    "directory": "packages/easy-npd"
  },
  "bin": {
    "npd": "bin/install.js",
    "npd-fetch": "bin/fetch.js",
    "npd-link": "bin/link.js",
    "npd-uninstall": "bin/uninstall.js",
    "npd-update": "bin/update.js"
  },
  "files": [
    "lib",
    "bin",
    "node-gyp-bin",
    "CHANGELOG.md"
  ],
  "main": "lib/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "npm run lint && mocha \"test/*.test.js\"",
    "test-cov": "c8 --reporter=text --reporter=lcov mocha \"test/*.test.js\"",
    "test-local": "npm_china=true local=true mocha --full-trace \"test/*.test.js\"",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "ci": "npm run lint && npm run test-cov",
    "prepublishOnly": "npm run lint"
  },
  "dependencies": {
    "@npmcli/arborist": "^6.1.3",
    "await-event": "^2.1.0",
    "bin-links": "^2.3.0",
    "binary-mirror-config": "^1.19.0",
    "bytes": "^3.1.0",
    "cacheable-lookup": "^6.1.0",
    "chalk": "^2.4.2",
    "cmd-shim-hotfix": "^3.0.3",
    "dayjs": "^1.11.23",
    "debug": "^4.1.1",
    "destroy": "^1.0.4",
    "detect-libc": "^2.0.1",
    "fs-extra": "^7.0.1",
    "minimatch": "^3.0.4",
    "minimist": "^1.2.0",
    "ms": "^2.1.1",
    "node-gyp": "^10.0.0",
    "node-homedir": "^1.1.1",
    "normalize-package-data": "^5.0.0",
    "npm-normalize-package-bin": "^3.0.0",
    "npm-package-arg": "^8.1.5",
    "ora": "^4.0.5",
    "p-map": "^2.1.0",
    "pacote": "^15.0.0",
    "runscript": "^1.3.0",
    "semver": "^7.0.0",
    "tar": "^7.5.22",
    "urllib": "^3.0.3",
    "utility": "^1.16.1"
  },
  "devDependencies": {
    "c8": "^9.1.0",
    "coffee": "5",
    "mm": "3",
    "mocha": "^11.7.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0"
  },
  "engines": {
    "node": ">=16.14.0"
  }
}
